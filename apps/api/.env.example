DATABASE_URL=
REDIS_URL=
STORAGE_DIR=./storage
ANTHROPIC_API_KEY=
# Generate with: openssl rand -base64 48
JWT_SECRET=
PORT=3001
# Optional: "off" stops this process from running the extraction worker
# (uploads are still enqueued). Default: on.
EXTRACTION_WORKER=
# Optional: namespace for BullMQ keys in Redis. Default: invoicio.
QUEUE_PREFIX=
